using UnityEngine;
using System.Collections.Generic;

public class GameManager : MonoBehaviour
{
    public static GameManager Instance;

    [Header("Participant Data")]
    public string participantCode;
    public string playerName;
    public string playerDegree;
    public string age;
    public bool agreedToResearch = false;

    [Header("Progress")]
    public int score = 0;
    public int currentTask = 0;

    [Header("Case Scores")]
    public int case1Score = 0;
    public int case2Score = 0;
    public int case3Score = 0;
    public int case4Score = 0;
    public int case5Score = 0;
    public int case6Score = 0;
    public int case7Score = 0;
    public int case8Score = 0;
    public int case9Score = 0;
    public int case10Score = 0;
    public int case11Score = 0;

    [Header("Saved Data")]
    public List<int> case5Choices = new List<int>();
    public List<int> case6Choices = new List<int>();
    public List<int> case7Choices = new List<int>();
    public List<int> case8Choices = new List<int>();
    public List<int> case9Choices = new List<int>();
    public List<int> case10Choices = new List<int>();
    public List<int> case11Choices = new List<int>();

    void Awake()
    {
        if (Instance == null)
        {
            Instance = this;
            DontDestroyOnLoad(gameObject);
        }
        else
        {
            Destroy(gameObject);
        }
    }

    public void SetParticipantData(string participantCode, string playerName, string playerDegree, string age, bool agreed)
    {
        this.participantCode = participantCode;
        this.playerName = playerName;
        this.playerDegree = playerDegree;
        this.age = age;
        this.agreedToResearch = agreed;
    }

    public void SetCurrentTask(int taskNumber)
    {
        currentTask = taskNumber;
        Debug.Log("Current task set to: " + currentTask);
    }

    public void AddPoints(int points)
    {
        score += points;
        Debug.Log("Added total points: " + points + " | Total score: " + score);
    }

    public void AddCase1Points(int points) { case1Score += points; score += points; }
    public void AddCase2Points(int points) { case2Score += points; score += points; }
    public void AddCase3Points(int points) { case3Score += points; score += points; }
    public void AddCase4Points(int points) { case4Score += points; score += points; }
    public void AddCase5Points(int points) { case5Score += points; score += points; }
    public void AddCase6Points(int points) { case6Score += points; score += points; }
    public void AddCase7Points(int points) { case7Score += points; score += points; }
    public void AddCase8Points(int points) { case8Score += points; score += points; }
    public void AddCase9Points(int points) { case9Score += points; score += points; }
    public void AddCase10Points(int points) { case10Score += points; score += points; }
    public void AddCase11Points(int points) { case11Score += points; score += points; }

    public void SaveCase5Choices(List<int> choices) => case5Choices = new List<int>(choices);
    public void SaveCase6Choices(List<int> choices) => case6Choices = new List<int>(choices);
    public void SaveCase7Choices(List<int> choices) => case7Choices = new List<int>(choices);
    public void SaveCase8Choices(List<int> choices) => case8Choices = new List<int>(choices);
    public void SaveCase9Choices(List<int> choices) => case9Choices = new List<int>(choices);
    public void SaveCase10Choices(List<int> choices) => case10Choices = new List<int>(choices);
    public void SaveCase11Choices(List<int> choices) => case11Choices = new List<int>(choices);
}